{
  "name": "rom-update-mini-server",
  "version": "1.0.0",
  "description": "ROM / 移植包下载小程序的本地后端。可在本地用 data.json 跑，部署到云托管 / 云服务器时自动切到 MySQL。",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate-to-mysql.js",
    "import-roms": "node import-hyperos.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mysql2": "^3.11.0"
  }
}
